{
  "function": {
    "prefix": "fun",
    "body": "function ${1:name}(${2:args})\n  ${3:-- body}\nend",
    "desc": "Lua function"
  },
  "local function": {
    "prefix": "lfun",
    "body": "local function ${1:name}(${2:args})\n  ${3:-- body}\nend",
    "desc": "Local lua function"
  },
  "for loop": {
    "prefix": "for",
    "body": "for ${1:i} = ${2:1}, ${3:10} do\n  ${4:-- body}\nend",
    "desc": "Numeric for loop"
  },
  "pairs loop": {
    "prefix": "pairs",
    "body": "for ${1:key}, ${2:value} in pairs(${3:table}) do\n  ${4:-- body}\nend",
    "desc": "Iterate table with pairs()"
  }
}
