{
  "name": "pi-powerline-footer",
  "version": "0.4.20",
  "description": "Powerline-style status bar extension for pi coding agent",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "powerline",
    "status-bar",
    "extension"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-powerline-footer.git"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "node_modules/@marckrenn/pi-sub-core/index.ts"
    ]
  },
  "dependencies": {
    "@marckrenn/pi-sub-core": "^1.5.0",
    "@marckrenn/pi-sub-shared": "^1.5.0"
  }
}
